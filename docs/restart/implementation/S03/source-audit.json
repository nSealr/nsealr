  "source_gaps": [
    {
      "id": "G01",
      "requirements": [
        "AUTH-01",
        "AUTH-02",
        "AUTH-03",
        "PROD-04"
      ],
      "path": "crates/nsealr-core/src/policy/approval_gate.rs",
      "symbols": [
        "ApprovalGate",
        "begin_review",
        "approve",
        "can_sign"
      ],
      "observation": "Public Clone gate accepts arbitrary request/digest strings; can_sign borrows and does not consume. Empty initial strings can also match approve. No operation, custody, epoch, policy or deadline is owned.",
      "planned_change": "Replace authority with private non-Clone state in one AuthorizationSession; remove reusable public authority.",
      "acceptance_cases": [
        "A01",
        "A02",
        "A03",
        "A04",
        "A05"
      ]
    },
    {
      "id": "G02",
      "requirements": [
        "AUTH-01",
        "AUTH-04",
        "PROD-05"
      ],
      "path": "crates/nsealr-core/src/review/trusted.rs",
      "symbols": [
        "TrustedReviewSession::new",
        "current_frame",
        "handle_button"
      ],
      "observation": "Constructible pages/digest and Clone session are independent of actual canonical event. Logical Next skips remaining scroll windows and there is no successful-display acknowledgement.",
      "planned_change": "Generate complete immutable operation-bound review and require all flat pages successfully shown before local consent.",
      "acceptance_cases": [
        "A01",
        "R01",
        "R02",
        "R03"
      ]
    },
    {
      "id": "G03",
      "requirements": [
        "PROD-01",
        "AUTH-02",
        "AUTH-05"
      ],
      "path": "crates/nsealr-core/src/session/account.rs",
      "symbols": [
        "select_session_account",
        "SelectedSessionAccount"
      ],
      "observation": "Descriptor pubkey is syntax checked and copied; source_public_key_proof_verified explicitly false. Source fingerprint is not actual public-key derivation.",
      "planned_change": "Consume actual S02 standalone key into private backend owner and derive x-only key using k256.",
      "acceptance_cases": [
        "I01",
        "A02",
        "V01"
      ]
    },
    {
      "id": "G04",
      "requirements": [
        "PROD-05",
        "PROD-09"
      ],
      "path": "crates/nsealr-core/src/qr/envelope.rs",
      "symbols": [
        "Scanner::for_each_member",
        "Scanner::parse_number_token",
        "Scanner::skip_container",
        "parse_qr_signing_request"
      ],
      "observation": "Duplicate object values overwrite; trailing comma tolerated; container skipping does not validate nested grammar; kind admits i32 range; leading zero integer tokens can survive. Fixed byte limits already exist.",
      "planned_change": "One schema-directed strict parser with decoded-name duplicate rejection, strict integer grammar, u16 kind and complete input consumption.",
      "acceptance_cases": [
        "P01",
        "P02",
        "P03",
        "L01"
      ]
    },
    {
      "id": "G05",
      "requirements": [
        "PROD-05",
        "PROD-09"
      ],
      "path": "crates/nsealr-core/src/protocol.rs",
      "symbols": [
        "skip_json_value",
        "parse_request_metadata",
        "handle_serial_frame_with_review_preview"
      ],
      "observation": "Second recursive lenient scanner has no trailing-data check, permissive separators and inconsistent duplicate behavior. Handler emits signing_disabled, which is a retained safety boundary.",
      "planned_change": "Use shared strict parser for every envelope method; keep disabled signing response independent of readiness flags.",
      "acceptance_cases": [
        "P01",
        "P02",
        "L01",
        "D01"
      ]
    },
    {
      "id": "G06",
      "requirements": [
        "AUTH-02",
        "AUTH-05"
      ],
      "path": "crates/nsealr-core/src/review/qr.rs",
      "symbols": [
        "qr_approval_digest",
        "DigestWriter",
        "push_pages_json"
      ],
      "observation": "Hashes a legacy review JSON with caller identity; does not compute the NIP-01 event ID. No implemented NIP-01 signing backend in core.",
      "planned_change": "Canonicalize complete owned event with custody key; use separate domain-bound review commitment.",
      "acceptance_cases": [
        "C01",
        "C02",
        "V01",
        "A02"
      ]
    },
    {
      "id": "G07",
      "requirements": [
        "PROD-05",
        "AUTH-01"
      ],
      "path": "crates/nsealr-core/src/review/qr.rs",
      "symbols": [
        "for_each_summary_event",
        "display_safe_text",
        "build_qr_display_review_pages"
      ],
      "observation": "Generic kind/tag display has no P01 kind-specific admission. U+XXXX non-ASCII spelling can collide with literal text; literal backslashes are not escaped in current safe view.",
      "planned_change": "Admit only fully specified kind1 semantics; distinct indexed interpreted/additional data and injective escaping.",
      "acceptance_cases": [
        "R01",
        "R02",
        "KIND01",
        "KIND02"
      ]
    },
    {
      "id": "G08",
      "requirements": [
        "PROD-05",
        "AUTH-01"
      ],
      "path": "crates/nsealr-core/src/review/display.rs",
      "symbols": [
        "bounded_body_lines",
        "truncate_for_display",
