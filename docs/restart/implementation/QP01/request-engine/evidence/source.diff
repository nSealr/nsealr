diff --git a/crates/nsealr-pi-engine-fixture/src/lib.rs b/crates/nsealr-pi-engine-fixture/src/lib.rs
new file mode 100644
index 00000000..ce58cefd
--- /dev/null
+++ b/crates/nsealr-pi-engine-fixture/src/lib.rs
@@ -0,0 +1,387 @@
+//! Synchronous request-aware host engineering ABI, using only public test-key-1.
+//! Trusted callers/presenters/providers are in the same process TCB. No device,
+//! production custody, callback preemption or hostile-pointer isolation claim.
+#[cfg(panic = "abort")]
+compile_error!("the host fixture ABI requires unwind, not abort-only compilation");
+
+use nsealr_core::{
+    authorization::{
+        AuthorizationError, AuthorizationSession, AuthorizationState, AuxiliaryError,
+        AuxiliarySource, LocalDisplayError, LocalInput, LocalPresentation, LocalReviewIo,
+        REVIEW_LIFETIME, SIGNED_EVENT_BYTES,
+    },
+    event::{OperationLimits, ParsedRequest, RequestMethod},
+    nip19::SecretKey,
+    qr::envelope::{decode_qr_envelope, encode_qr_envelope_json},
+    review::event::{InspectionError, InspectionGeometry},
+};
+use std::{
+    cell::Cell,
+    panic::{catch_unwind, AssertUnwindSafe},
+    sync::atomic::{AtomicBool, Ordering},
+};
+
+pub type Present =
+    extern "C" fn(u32, u32, u32, *const u8, usize, *const u8, usize, *const u8, usize) -> i32;
+pub type Now = extern "C" fn(*mut u64) -> i32;
+pub type Aux = extern "C" fn(*mut u8, usize) -> i32;
+pub type Cancelled = extern "C" fn() -> i32;
+const FRAME: usize = 947;
+const JSON: usize = 704;
+const ARGUMENT: i32 = -1;
+const BUSY: i32 = -2;
+const REQUEST: i32 = -3;
+const UNSUPPORTED: i32 = -4;
+const REJECTED: i32 = -5;
+const DISPLAY: i32 = -6;
+const CLOCK: i32 = -7;
+const AUXILIARY: i32 = -8;
+const ENGINE: i32 = -9;
+const CAPACITY: i32 = -10;
+const CANCELLED: i32 = -11;
+const PANIC: i32 = -12;
+static ACTIVE: AtomicBool = AtomicBool::new(false);
+
+struct Active;
+impl Active {
+    fn acquire() -> Result<Self, i32> {
+        ACTIVE
+            .compare_exchange(false, true, Ordering::Acquire, Ordering::Relaxed)
+            .map(|_| Self)
+            .map_err(|_| BUSY)
+    }
+}
+impl Drop for Active {
+    fn drop(&mut self) {
+        ACTIVE.store(false, Ordering::Release);
+    }
+}
+struct Owner(AuthorizationSession);
+impl Drop for Owner {
+    fn drop(&mut self) {
+        self.0.cancel();
+        // Fresh owner per call cannot exhaust its session generation.
+        let _ = self.0.lock();
+    }
+}
+
+fn limits() -> OperationLimits {
+    OperationLimits {
+        input_bytes: JSON,
+        content_bytes: 512,
+        tags: 16,
+        fields_per_tag: 8,
+        field_bytes: 64,
+        ..OperationLimits::conformance()
+    }
+}
+
+struct Freshness {
+    now: Now,
+    cancelled: Cancelled,
+    last: Cell<Option<u64>>,
+    deadline: Cell<Option<u64>>,
+    failure: Cell<i32>,
+}
+impl Freshness {
+    fn sample(&self) -> Option<u64> {
+        if self.failure.get() != 0 {
+            return None;
+        }
+        let mut tick = 0;
+        let failure = match (self.cancelled)() {
+            0 => {
+                if (self.now)(&mut tick) != 0
+                    || self.last.get().is_some_and(|last| tick < last)
+                    || self.deadline.get().is_some_and(|deadline| tick >= deadline)
+                {
+                    CLOCK
+                } else {
+                    0
+                }
+            }
+            1 => CANCELLED,
+            _ => CANCELLED,
+        };
+        self.failure.set(failure);
+        if failure != 0 {
+            return None;
+        }
+        self.last.set(Some(tick));
+        Some(tick)
+    }
+    fn error(&self, error: AuthorizationError) -> i32 {
+        if self.failure.get() != 0 {
+            return self.failure.get();
+        }
+        match error {
+            AuthorizationError::Clock | AuthorizationError::Expired => CLOCK,
+            AuthorizationError::Auxiliary => AUXILIARY,
+            AuthorizationError::Display => DISPLAY,
+            AuthorizationError::Parse(_) => REQUEST,
+            AuthorizationError::Inspection(InspectionError::Unsupported) => UNSUPPORTED,
+            AuthorizationError::Output => CAPACITY,
+            _ => ENGINE,
+        }
+    }
+}
+struct Ui<'a> {
+    present: Present,
+    fresh: &'a Freshness,
+}
+impl LocalReviewIo for Ui<'_> {
+    fn now(&mut self) -> Option<u64> {
+        self.fresh.sample()
+    }
+    fn present(
+        &mut self,
+        presentation: LocalPresentation<'_>,
+    ) -> Result<LocalInput, LocalDisplayError> {
+        let (kind, page) = match presentation {
+            LocalPresentation::Data(page) => (0, page),
+            LocalPresentation::Decision(page) => (1, page),
+        };
+        match (self.present)(
+            kind,
+            page.index() as u32,
+            page.total() as u32,
+            page.label().as_ptr(),
+            page.label().len(),
+            page.body().as_ptr(),
+            page.body().len(),
+            page.position().as_ptr(),
+            page.position().len(),
+        ) {
+            0 => Ok(LocalInput::Next),
+            1 => Ok(LocalInput::Approve),
+            2 => Ok(LocalInput::Reject),
+            3 => Ok(LocalInput::Back),
+            4 => Ok(LocalInput::None),
+            _ => Err(LocalDisplayError),
+        }
+    }
+}
+struct Auxiliary(Aux);
+impl AuxiliarySource for Auxiliary {
+    fn fill(&mut self, destination: &mut [u8; 32]) -> Result<usize, AuxiliaryError> {
+        usize::try_from((self.0)(destination.as_mut_ptr(), destination.len()))
+            .map_err(|_| AuxiliaryError::Provider)
+    }
+}
+
+fn append(out: &mut [u8], length: &mut usize, bytes: &[u8]) -> Result<(), i32> {
+    let end = length.checked_add(bytes.len()).ok_or(CAPACITY)?;
+    out.get_mut(*length..end)
+        .ok_or(CAPACITY)?
+        .copy_from_slice(bytes);
+    *length = end;
+    Ok(())
+}
+
+fn run(
+    input: &[u8],
+    present: Present,
+    now: Now,
+    aux: Aux,
+    cancelled: Cancelled,
+    output: &mut [u8],
+) -> Result<usize, i32> {
+    // Copy all original bytes before the first external callback.
+    let mut frame = [0u8; FRAME];
+    frame[..input.len()].copy_from_slice(input);
+    let mut raw = [0u8; JSON];
+    let decoded = decode_qr_envelope(&frame[..input.len()], &mut raw).map_err(|_| REQUEST)?;
+    let request = ParsedRequest::parse(decoded.payload_json, limits()).map_err(|_| REQUEST)?;
+    if request.method() == RequestMethod::Capabilities {
+        return Err(UNSUPPORTED);
+    }
+    let fresh = Freshness {
+        now,
+        cancelled,
+        last: Cell::new(None),
+        deadline: Cell::new(None),
+        failure: Cell::new(0),
+    };
+    let intake = fresh.sample().ok_or_else(|| fresh.failure.get())?;
+    fresh
+        .deadline
+        .set(Some(intake.checked_add(REVIEW_LIFETIME).ok_or(CLOCK)?));
+    let mut scalar = [0x11; 32]; // Already published test-key-1. No secret crosses FFI.
+    let key = SecretKey::take_from(&mut scalar).expect("fixed nonzero public test scalar");
+    let mut owner = Owner(
+        AuthorizationSession::new(
+            limits(),
+            InspectionGeometry {
+                columns: 32,
+                lines: 8,
+            },
+        )
+        .expect("fixed validated conformance subset"),
+    );
+    owner
+        .0
+        .select_key(key)
+        .expect("fixed valid public fixture key");
+    let mut event = [0u8; SIGNED_EVENT_BYTES];
+    let mut public = [0u8; 64];
+    let result: &[u8] = match request.method() {
+        RequestMethod::PublicKey => {
+            for (pair, byte) in public
+                .chunks_exact_mut(2)
+                .zip(owner.0.public_key().expect("selected key"))
+            {
+                pair[0] = b"0123456789abcdef"[(byte >> 4) as usize];
+                pair[1] = b"0123456789abcdef"[(byte & 15) as usize];
+            }
+            &public
+        }
+        // Capabilities was refused before any external callback.
+        _ => {
+            owner
+                .0
+                .begin_request(decoded.payload_json, Some(intake))
+                .map_err(|e| fresh.error(e))?;
+            let mut ui = Ui {
+                present,
+                fresh: &fresh,
+            };
+            for _ in 0..1024 {
+                if owner.0.state() != AuthorizationState::Reviewing {
+                    break;
+                }
+                owner.0.review_step(&mut ui).map_err(|e| fresh.error(e))?;
+            }
+            match owner.0.state() {
+                AuthorizationState::Spent => return Err(REJECTED),
+                AuthorizationState::Approved => (),
+                _ => return Err(ENGINE),
+            }
+            // Core consumes approval BEFORE invoking fresh.sample/cancel/provider.
+            let length = owner
+                .0
+                .sign_approved(
+                    request.request_id(),
+                    &mut || fresh.sample(),
+                    &mut Auxiliary(aux),
+                    &mut event,
+                )
+                .map_err(|e| fresh.error(e))?;
+            &event[..length]
+        }
+    };
+    let mut json = [0u8; JSON];
+    let mut length = 0;
+    let is_key = request.method() == RequestMethod::PublicKey;
+    for part in [
+        b"{\"version\":2,\"request_id\":\"".as_slice(),
+        request.request_id().as_bytes(),
+        b"\",\"ok\":true,\"result\":{",
+        if is_key {
+            b"\"public_key\":\""
+        } else {
+            b"\"event\":"
+        },
+        result,
+        if is_key { b"\"}}" } else { b"}}" },
+    ] {
+        append(&mut json, &mut length, part)?;
+    }
+    let mut staged = [0u8; FRAME];
+    let encoded = encode_qr_envelope_json(&json[..length], &mut staged).map_err(|_| CAPACITY)?;
+    if encoded.len() > output.len() {
+        return Err(CAPACITY);
+    }
+    // Last logical admission sample after all private serialization/staging.
+    // It is not a hard-real-time return bound or an interruptible callback.
+    fresh.sample().ok_or_else(|| fresh.failure.get())?;
+    output[..encoded.len()].copy_from_slice(encoded);
+    Ok(encoded.len())
+}
+
+fn range(start: usize, length: usize) -> Option<(usize, usize)> {
+    if start == 0 || length == 0 || length > isize::MAX as usize {
+        return None;
+    }
+    Some((start, start.checked_add(length)?))
+}
+fn disjoint(a: (usize, usize), b: (usize, usize)) -> bool {
+    a.1 <= b.0 || b.1 <= a.0
+}
+
+fn settled(
+    output: &mut [u8],
+    operation: impl FnOnce(&mut [u8]) -> Result<usize, i32>,
+) -> Result<usize, i32> {
+    let result = catch_unwind(AssertUnwindSafe(|| operation(output))).unwrap_or(Err(PANIC));
+    if result.is_err() {
+        output.fill(0);
+    }
+    result
+}
+
+/// Run the actual request using only the already-public fixture11x32 identity.
+///
+/// # Safety
+/// Input/output/written must be live, aligned as required, nonoverlapping and
+/// unaliased for this synchronous call. Address checks do not prove validity.
+/// Callbacks must remain alive, never unwind across C, never retain spans, and
+/// cease all writes before return. The entire Python/native process is trusted.
+/// ARGUMENT/BUSY touch no pointers. Admitted failure zeroes whole output/written.
+#[no_mangle]
+pub unsafe extern "C" fn qp01_fixture_request_v1(
+    input: *const u8,
+    input_bytes: usize,
+    present: Option<Present>,
+    now: Option<Now>,
+    aux: Option<Aux>,
+    cancelled: Option<Cancelled>,
+    output: *mut u8,
+    capacity: usize,
+    written: *mut usize,
+) -> i32 {
+    let _active = match Active::acquire() {
+        Ok(active) => active,
+        Err(status) => return status,
+    };
+    let (Some(i), Some(o), Some(w), Some(present), Some(now), Some(aux), Some(cancelled)) = (
+        range(input as usize, input_bytes),
+        range(output as usize, capacity),
+        range(written as usize, size_of::<usize>()),
+        present,
+        now,
+        aux,
+        cancelled,
+    ) else {
+        return ARGUMENT;
+    };
+    if input_bytes > FRAME
+        || capacity > FRAME
+        || !written.is_aligned()
+        || !disjoint(i, o)
+        || !disjoint(i, w)
+        || !disjoint(o, w)
+    {
+        return ARGUMENT;
+    }
+    // SAFETY: caller live/aligned/unaliased contract plus validated sizes/ranges.
+    let output = unsafe { std::slice::from_raw_parts_mut(output, capacity) };
+    let input = unsafe { std::slice::from_raw_parts(input, input_bytes) };
+    output.fill(0);
+    unsafe {
+        *written = 0;
+    }
+    match settled(output, |output| {
+        run(input, present, now, aux, cancelled, output)
+    }) {
+        Ok(length) => {
+            unsafe {
+                *written = length;
+            }
+            0
+        }
+        Err(status) => status,
+    }
+}
+
+#[cfg(test)]
+mod tests;
diff --git a/crates/nsealr-pi-engine-fixture/src/tests.rs b/crates/nsealr-pi-engine-fixture/src/tests.rs
new file mode 100644
index 00000000..1f284b30
--- /dev/null
+++ b/crates/nsealr-pi-engine-fixture/src/tests.rs
@@ -0,0 +1,435 @@
+use super::*;
+use std::{cell::RefCell, sync::Mutex};
+
+const BASIC: &[u8] = br#"{"version":2,"request_id":"req-kind-1-basic","method":"sign_event","params":{"event_template":{"created_at":1710000000,"kind":1,"tags":[],"content":"nSealr fixture: basic kind 1 event."}}}"#;
+const GET: &[u8] = br#"{"version":2,"request_id":"req-pubkey-1","method":"get_public_key"}"#;
+static SERIAL: Mutex<()> = Mutex::new(());
+type ObservedPage = (u32, u32, u32, Vec<u8>, Vec<u8>, Vec<u8>);
+#[derive(Default)]
+struct State {
+    clocks: usize,
+    cancel_calls: usize,
+    pages: Vec<ObservedPage>,
+    providers: usize,
+    action: Option<i32>,
+    fail_clock: usize,
+    cancel_at: usize,
+    tick: u64,
+    rollback_at: usize,
+    expire_at: usize,
+    aux_report: Option<i32>,
+    prefix: usize,
+    reenter_clock: bool,
+    reenter_present: bool,
+    did_back: bool,
+    back: bool,
+    invalid_cancel: bool,
+}
+thread_local! { static STATE: RefCell<State> = RefCell::new(State::default()); }
+fn reset() {
+    STATE.with(|s| *s.borrow_mut() = State::default());
+}
+extern "C" fn present(
+    kind: u32,
+    index: u32,
+    total: u32,
+    l: *const u8,
+    ln: usize,
+    b: *const u8,
+    bn: usize,
+    p: *const u8,
+    pn: usize,
+) -> i32 {
+    STATE.with(|s| {
+        let mut s = s.borrow_mut();
+        s.pages.push((
+            kind,
+            index,
+            total,
+            unsafe { std::slice::from_raw_parts(l, ln).to_vec() },
+            unsafe { std::slice::from_raw_parts(b, bn).to_vec() },
+            unsafe { std::slice::from_raw_parts(p, pn).to_vec() },
+        ));
+        if s.reenter_present {
+            assert_busy();
+        }
+        if s.back && index == 1 && !s.did_back {
+            s.did_back = true;
+            return 3;
+        }
+        s.action.unwrap_or(if kind == 1 { 1 } else { 0 })
+    })
+}
+extern "C" fn now(tick: *mut u64) -> i32 {
+    STATE.with(|s| {
+        let mut s = s.borrow_mut();
+        s.clocks += 1;
+        if s.reenter_clock {
+            assert_busy();
+        }
+        if s.clocks == s.fail_clock {
+            return -1;
+        }
+        unsafe {
+            *tick = if s.clocks == s.rollback_at {
+                0
+            } else if s.clocks == s.expire_at {
+                s.tick + 100
+            } else {
+                s.tick
+            };
+        }
+        0
+    })
+}
+extern "C" fn aux(out: *mut u8, cap: usize) -> i32 {
+    assert_eq!(cap, 32);
+    STATE.with(|s| {
+        let mut s = s.borrow_mut();
+        s.providers += 1;
+        unsafe {
+            std::slice::from_raw_parts_mut(out, cap)[..s.prefix].fill(0x55);
+        }
+        s.aux_report.unwrap_or(32)
+    })
+}
+extern "C" fn cancelled() -> i32 {
+    STATE.with(|s| {
+        let mut s = s.borrow_mut();
+        s.cancel_calls += 1;
+        if s.invalid_cancel {
+            -1
+        } else {
+            i32::from(s.cancel_at == s.cancel_calls)
+        }
+    })
+}
+fn encode(json: &[u8]) -> Vec<u8> {
+    let mut buffer = [0; FRAME];
+    encode_qr_envelope_json(json, &mut buffer).unwrap().to_vec()
+}
+fn call(input: &[u8], capacity: usize) -> (i32, usize, Vec<u8>) {
+    let mut output = vec![0xa5; capacity];
+    let mut written = 123;
+    let status = unsafe {
+        qp01_fixture_request_v1(
+            input.as_ptr(),
+            input.len(),
+            Some(present),
+            Some(now),
+            Some(aux),
+            Some(cancelled),
+            output.as_mut_ptr(),
+            output.len(),
+            &mut written,
+        )
+    };
+    if status != 0 && status != ARGUMENT && status != BUSY {
+        assert_eq!(written, 0);
+        assert!(output.iter().all(|b| *b == 0));
+    }
+    if status == 0 {
+        assert!(output[written..].iter().all(|b| *b == 0));
+    }
+    (status, written, output)
+}
+fn assert_busy() {
+    // Invalid addresses are never borrowed: BUSY must precede all validation.
+    assert_eq!(
+        unsafe {
+            qp01_fixture_request_v1(
+                std::ptr::null(),
+                usize::MAX,
+                None,
+                None,
+                None,
+                None,
+                std::ptr::null_mut(),
+                usize::MAX,
+                std::ptr::null_mut(),
+            )
+        },
+        BUSY
+    );
+}
+
+#[test]
+fn actual_ffi_effects_and_boundaries() {
+    let _serial = SERIAL.lock().unwrap();
+    reset();
+    let basic = encode(BASIC);
+    let get = encode(GET);
+    let (status, length, output) = call(&basic, FRAME);
+    assert_eq!((status, length), (0, 611));
+    let mut decoded = [0; JSON];
+    let json = decode_qr_envelope(&output[..length], &mut decoded)
+        .unwrap()
+        .payload_json;
+    assert!(json
+        .windows(64)
+        .any(|p| p == b"2977f107ad2668dbd9f09b8594eff3b5276e21bfe098e60ae3e905e3c861e4d3"));
+    STATE.with(|s| {
+        let s = s.borrow();
+        assert_eq!(s.providers, 1);
+        for (i, p) in s.pages.iter().enumerate() {
+            assert_eq!(p.1 as usize, i);
+            assert_eq!(p.2 as usize, s.pages.len());
+            assert_eq!(p.5, format!("{}/{}", i + 1, s.pages.len()).as_bytes());
+        }
+        assert_eq!(s.pages.last().unwrap().0, 1);
+    });
+    let clocks = STATE.with(|s| s.borrow().clocks);
+    for stage in 1..=clocks {
+        reset();
+        STATE.with(|s| s.borrow_mut().fail_clock = stage);
+        assert_eq!(call(&basic, FRAME).0, CLOCK);
+        assert_eq!(STATE.with(|s| s.borrow().clocks), stage);
+        assert_eq!(
+            STATE.with(|s| s.borrow().providers),
+            usize::from(stage >= clocks - 1)
+        );
+        reset();
+        STATE.with(|s| {
+            let mut s = s.borrow_mut();
+            s.tick = 1;
+            s.rollback_at = stage;
+        });
+        if stage > 1 {
+            assert_eq!(call(&basic, FRAME).0, CLOCK);
+        }
+        reset();
+        STATE.with(|s| s.borrow_mut().expire_at = stage);
+        if stage > 1 {
+            assert_eq!(call(&basic, FRAME).0, CLOCK);
+        }
+        reset();
+        STATE.with(|s| s.borrow_mut().cancel_at = stage);
+        assert_eq!(call(&basic, FRAME).0, CANCELLED);
+    }
+    reset();
+    STATE.with(|s| s.borrow_mut().tick = u64::MAX);
+    assert_eq!(call(&get, FRAME).0, CLOCK);
+    reset();
+    STATE.with(|s| s.borrow_mut().invalid_cancel = true);
+    assert_eq!(call(&get, FRAME).0, CANCELLED);
+    for (action, expected) in [(1, ENGINE), (2, REJECTED), (4, ENGINE), (99, DISPLAY)] {
+        reset();
