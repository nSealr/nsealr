+      expect(await handleLocalServiceRequestAsync(state.envelope, state.context)).toMatchObject({ ok: time < 100 });
+      expect(state.writes.length).toBe(time < 100 ? 1 : 0);
+    }
+    for (const bad of [undefined, Number.MAX_SAFE_INTEGER, -1]) {
