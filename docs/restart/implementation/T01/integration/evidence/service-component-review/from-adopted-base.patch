+      expect((await handleLocalServiceRequestAsync(state.envelope, state.context)).ok).toBe(false);
+      expect(state.writes).toHaveLength(0);
+    }
+    const rollback = setup(); let reads = 0;
+    rollback.context.monotonicNow = () => ++reads === 1 ? 10 : 9;
