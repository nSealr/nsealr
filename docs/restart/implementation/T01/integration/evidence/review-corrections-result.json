    "T01-ARTIFACT-01": {
      "change": "Remove only retired card_slot recovery from new account schema and independent reference; preserve four supported alternatives. Add negative and exact schema recovery-alternative assertion.",
      "reference_tests": 99,
      "schema_engine_run": false,
      "schema_control": "Existing unittest asserts exact supported recovery branch set; no JSON Schema dependency/engine added."
    },
    "T01-SERVICE-01": {
      "change": "Async dispatch calls the existing authorizeClient before preparation/observations/adapter.",
      "regression": "Same four denied cases on sync+async have zero observations and adapter calls; authorized controls succeed. Reused actual driver witness confirms zero opens/writes/closes denied and one each authorized."
    },
    "T01-SERVICE-02": {
      "change": "Pass effective frame_bytes into serial transport; enforce positive integer <= existing1024global bound, actual UTF8 frame bytes checked before write or incoming decode. Existing work ceiling remains independent.",
      "regression": "Fixed67/142 compact JSON bytes imply125/226 byte frames using unchanged nine-character prefix/checksum; below/exact/above tests and oversized valid peer error via actual narrowed driver. H01 actual431 frame rejected under226 cap with one write and close."
    },
    "T01-SERVICE-03": {
      "change": "Attach observer to wrapped sync promise immediately before post-dispatch revalidation can return early. Reservation tracks actual settlement; hooks revoked immediately.",
      "regression": "Inline generation change, late rejection, no unhandledRejection; blocked retry before settlement and successful recovery afterward."
    }
  },
  "test_totals": {
    "service_component_focused": 85,
    "reference": 99
  },
  "meaningful_failures_preserved": [
    "Reference accepted retired recovery before correction.",
    "Async unpaired request reached dispatch before correction.",
