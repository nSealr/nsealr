  "observations": [
    {
      "id": "G01",
      "source": "nSealr/nsealr:crates/nsealr-core/src/policy/signing_policy.rs",
      "symbols": [
        "SigningReadiness",
        "evaluate_signing_readiness"
      ],
      "finding": "Twelve public bool fields feed one universal gate list; all true produces signing_enabled even with development_accepted_gates populated. No profile selector or independent evidence boundary.",
      "required_change": "Replace with profile-specific typed diagnostic evaluation; never authorization or physical proof.",
      "criteria": [
        "T01-1",
        "T01-2"
      ]
    },
    {
      "id": "G02",
      "source": "nSealr/nsealr:crates/nsealr-core/src/protocol.rs",
      "symbols": [
        "DeviceProtocolContext",
        "get_capabilities",
        "scaffold_signing_readiness"
      ],
      "finding": "Hardcoded ESP32-S3 scaffold advertises four methods and two booleans. sign_event returns signing_disabled. Fixed response JSON buffer 768 bytes and serial frame cap 1024.",
      "required_change": "Versioned bounded metadata from explicit local profile; preserve disabled production signing and transport bounds.",
      "criteria": [
        "T01-1",
        "T01-3",
        "T01-4"
      ]
    },
    {
      "id": "G03",
      "source": "nSealr/nsealr:crates/nsealr-core/src/session/account.rs",
      "symbols": [
        "select_session_account",
        "device_protocol_context_for_session_account"
      ],
      "finding": "Selected public key comes from descriptor; source_public_key_proof_verified is false. Shape/fingerprint equality is not derivation or attestation.",
      "required_change": "Keep descriptor diagnostic; real identity proof remains custody boundary S03/K01/S02.",
      "criteria": [
        "T01-1",
        "T01-3"
      ]
    },
    {
      "id": "G04",
      "source": "nSealr/companion:packages/protocol/src/protocol.ts",
      "symbols": [
        "CAPABILITY_METHODS",
        "validateCapabilities",
        "validateSigningStatus"
      ],
      "finding": "Four fixed methods. Capability/device objects do not reject unknown fields or duplicate arrays, unlike schema. Universal gate status persists.",
      "required_change": "Exact versioned contract and strict ingress/validator agreement; remove old status path.",
      "criteria": [
        "T01-1",
        "T01-3",
        "T01-4"
      ]
    },
