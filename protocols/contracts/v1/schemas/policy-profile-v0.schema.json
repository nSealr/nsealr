{
  "$id": "https://nsealr.dev/schemas/policy-profile-v0.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "route_types": {
            "contains": {
              "enum": [
                "raspberry_qr_vault",
                "esp32_qr_vault"
              ]
            }
          }
        },
        "required": [
          "route_types"
        ]
      },
      "then": {
        "properties": {
          "grants_allowed": {
            "const": false
          },
          "mode": {
            "const": "manual_only"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "route_types": {
            "contains": {
              "const": "external_nip46"
            }
          }
        },
        "required": [
          "route_types"
        ]
      },
      "then": {
        "properties": {
          "grants_allowed": {
            "const": false
          },
          "mode": {
            "const": "manual_only"
          }
        }
      }
    }
  ],
  "properties": {
    "forbidden_permissions": {
      "items": {
        "enum": [
          "companion_authoritative_policy_change",
          "decrypt_without_review",
          "export_secret",
          "local_private_key_storage",
          "trusted_review_claim",
          "wildcard"
        ]
      },
      "type": "array",
      "uniqueItems": true
    },
    "format": {
      "const": "nsealr-policy-profile-v0"
    },
    "grant_constraints": {
      "additionalProperties": false,
      "properties": {
        "audit_log_required": {
          "type": "boolean"
        },
        "device_confirmation_required": {
          "type": "boolean"
        },
        "expiry_required": {
          "type": "boolean"
        },
        "rate_limit_required": {
          "type": "boolean"
        },
        "revocation_required": {
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "grants_allowed": {
      "type": "boolean"
    },
    "label": {
      "minLength": 1,
      "type": "string"
    },
    "manual_review_required": {
      "items": {
        "enum": [
          "connect",
          "delete_event",
          "nip04_decrypt",
          "nip44_decrypt",
          "policy_change",
          "sign_event",
          "switch_relays",
          "unknown_method"
        ]
      },
      "type": "array",
      "uniqueItems": true
    },
    "mode": {
      "enum": [
        "manual_only",
        "scoped_automation"
      ]
    },
    "policy_id": {
      "pattern": "^policy-[A-Za-z0-9._:-]{1,121}$",
      "type": "string"
    },
    "risk_tiers": {
      "additionalProperties": {
        "enum": [
          "device_review",
          "external_policy",
          "external_review",
          "low_scoped",
          "manual"
        ]
      },
      "propertyNames": {
        "enum": [
          "decrypt",
          "delete",
          "kind:1",
          "policy_change",
          "profile",
          "sign_event",
          "unknown"
        ]
      },
      "type": "object"
    },
    "route_types": {
      "items": {
        "enum": [
          "raspberry_qr_vault",
          "esp32_qr_vault",
          "esp32_usb_nip46",
          "custom_hardware_wallet",
          "external_nip46"
        ]
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    }
  },
  "required": [
    "format",
    "policy_id",
    "label",
    "route_types",
    "mode",
    "grants_allowed",
    "manual_review_required",
    "forbidden_permissions",
    "risk_tiers"
  ],
  "title": "nSealr Policy Profile v0",
  "type": "object"
}
