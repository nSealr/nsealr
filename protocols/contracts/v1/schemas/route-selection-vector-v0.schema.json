{
  "$id": "https://nsealr.dev/schemas/route-selection-vector-v0.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "nsealr-route-selection-vector-v0"
    },
    "name": {
      "pattern": "^[A-Za-z0-9._:-]{1,128}$",
      "type": "string"
    },
    "request": {
      "additionalProperties": false,
      "properties": {
        "account_id": {
          "pattern": "^[A-Za-z0-9._:-]{1,128}$",
          "type": "string"
        },
        "method": {
          "minLength": 1,
          "type": "string"
        },
        "route_type": {
          "enum": [
            "raspberry_qr_vault",
            "esp32_qr_vault",
            "esp32_usb_nip46",
            "custom_hardware_wallet",
            "external_nip46"
          ]
        }
      },
      "required": [
        "account_id",
        "method"
      ],
      "type": "object"
    },
    "selection": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "route_type": {
                "const": "raspberry_qr_vault"
              }
            },
            "required": [
              "route_type"
            ]
          },
          "then": {
            "properties": {
              "custody": {
                "const": "stateless_session"
              },
              "persistent_grants": {
                "const": false
              },
              "physical_approval": {
                "const": true
              },
              "physical_review": {
                "const": true
              },
              "policy_support": {
                "const": "manual_only"
              },
              "repository": {
                "const": "nsealr"
              },
              "transport": {
                "const": "qr"
              },
              "trusted_review": {
                "const": "device_display"
              }
            },
            "required": [
              "repository"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "route_type": {
                "const": "esp32_qr_vault"
              }
            },
            "required": [
              "route_type"
            ]
          },
          "then": {
            "properties": {
              "custody": {
                "const": "stateless_session"
              },
              "persistent_grants": {
                "const": false
              },
              "physical_approval": {
                "const": true
              },
              "physical_review": {
                "const": true
              },
              "policy_support": {
                "const": "manual_only"
              },
              "repository": {
                "const": "nsealr"
              },
              "transport": {
                "const": "qr"
              },
              "trusted_review": {
                "const": "device_display"
              }
            },
            "required": [
              "repository"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "route_type": {
                "const": "esp32_usb_nip46"
              }
            },
            "required": [
              "route_type"
            ]
          },
          "then": {
            "properties": {
              "custody": {
                "const": "device_persistent"
              },
              "persistent_grants": {
                "const": true
              },
              "physical_approval": {
                "const": true
              },
              "physical_review": {
                "const": true
              },
              "policy_support": {
                "const": "scoped_automation"
              },
              "repository": {
                "const": "nsealr"
              },
              "transport": {
                "const": "usb"
              },
              "trusted_review": {
                "const": "device_display"
              }
            },
            "required": [
              "repository"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "route_type": {
                "const": "custom_hardware_wallet"
              }
            },
            "required": [
              "route_type"
            ]
          },
          "then": {
            "properties": {
              "custody": {
                "const": "custom_hardware_persistent"
              },
              "persistent_grants": {
                "const": true
              },
              "physical_approval": {
                "const": true
              },
              "physical_review": {
                "const": true
              },
              "policy_support": {
                "const": "scoped_automation"
              },
              "repository": {
                "const": "nsealr"
              },
              "transport": {
                "const": "usb"
              },
              "trusted_review": {
                "const": "device_display"
              }
            },
            "required": [
              "repository"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "route_type": {
                "const": "external_nip46"
              }
            },
            "required": [
              "route_type"
            ]
          },
          "then": {
            "not": {
              "required": [
                "repository"
              ]
            },
            "properties": {
              "custody": {
                "const": "external_signer"
              },
              "persistent_grants": {
                "const": false
              },
              "physical_approval": {
                "const": false
              },
              "physical_review": {
                "const": false
              },
              "policy_support": {
                "const": "external"
              },
              "transport": {
                "const": "nip46_relay"
              },
              "trusted_review": {
                "const": "external_policy"
              }
            }
          }
        }
      ],
      "properties": {
        "account_id": {
          "pattern": "^[A-Za-z0-9._:-]{1,128}$",
          "type": "string"
        },
        "contains_secret_material": {
          "const": false
        },
        "custody": {
          "enum": [
            "stateless_session",
            "device_persistent",
            "custom_hardware_persistent",
            "external_signer"
          ]
        },
        "format": {
          "const": "nsealr-route-selection-v0"
        },
        "persistent_grants": {
          "type": "boolean"
        },
        "physical_approval": {
          "type": "boolean"
        },
        "physical_review": {
          "type": "boolean"
        },
        "policy_profile_id": {
          "pattern": "^policy-[A-Za-z0-9._:-]{1,121}$",
          "type": "string"
        },
        "policy_support": {
          "enum": [
            "manual_only",
            "scoped_automation",
            "external"
          ]
        },
        "public_key": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "repository": {
          "enum": [
            "nsealr"
          ]
        },
        "route_type": {
          "enum": [
            "raspberry_qr_vault",
            "esp32_qr_vault",
            "esp32_usb_nip46",
            "custom_hardware_wallet",
            "external_nip46"
          ]
        },
        "transport": {
          "enum": [
            "qr",
            "usb",
            "nip46_relay",
            "embedded"
          ]
        },
        "trusted_review": {
          "enum": [
            "device_display",
            "external_review",
            "external_policy"
          ]
        }
      },
      "required": [
        "format",
        "account_id",
        "public_key",
        "route_type",
        "transport",
        "custody",
        "trusted_review",
        "policy_support",
        "policy_profile_id",
        "physical_review",
        "physical_approval",
        "persistent_grants",
        "contains_secret_material"
      ],
      "type": "object"
    }
  },
  "required": [
    "name",
    "format",
    "request",
    "selection"
  ],
  "title": "nSealr route selection vector v0",
  "type": "object"
}
