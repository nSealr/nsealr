{
  "$id": "https://nsealr.dev/schemas/policy-decision-vector-v0.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "decision": {
      "additionalProperties": false,
      "properties": {
        "audit_event": {
          "additionalProperties": false,
          "properties": {
            "account_id": {
              "pattern": "^[A-Za-z0-9._:-]{1,128}$",
              "type": "string"
            },
            "client_pubkey": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            "decision": {
              "enum": [
                "allow",
                "deny",
                "manual_review"
              ]
            },
            "format": {
              "const": "nsealr-grant-audit-event-v0"
            },
            "grant_id": {
              "pattern": "^grant-[A-Za-z0-9._:-]{1,122}$",
              "type": "string"
            },
            "occurred_at": {
              "minimum": 1,
              "type": "integer"
            },
            "permission": {
              "additionalProperties": false,
              "properties": {
                "event_kind": {
                  "minimum": 0,
                  "type": "integer"
                },
                "method": {
                  "minLength": 1,
                  "type": "string"
                },
                "parameter": {
                  "type": "string"
                }
              },
              "required": [
                "method"
              ],
              "type": "object"
            },
            "reason": {
              "minLength": 1,
              "type": "string"
            },
            "route_type": {
              "enum": [
                "esp32_usb_nip46",
                "custom_hardware_wallet",
                "external_nip46"
              ]
            }
          },
          "required": [
            "format",
            "occurred_at",
            "account_id",
            "route_type",
            "client_pubkey",
            "permission",
            "decision",
            "reason"
          ],
          "type": "object"
        },
        "decision": {
          "enum": [
            "allow",
            "deny",
            "manual_review"
          ]
        },
        "format": {
          "const": "nsealr-policy-decision-v0"
        },
        "grant_id": {
          "pattern": "^grant-[A-Za-z0-9._:-]{1,122}$",
          "type": "string"
        },
        "reason": {
          "enum": [
            "decrypt_requires_manual_review",
            "forbidden_permission",
            "grant_expired",
            "grant_rate_limited",
            "grant_revoked",
            "grant_valid",
            "no_matching_grant",
            "policy_manual_only",
            "policy_route_mismatch",
            "unknown_method_requires_manual_review"
          ]
        }
      },
      "required": [
        "format",
        "decision",
        "reason",
        "audit_event"
      ],
      "type": "object"
    },
    "format": {
      "const": "nsealr-policy-decision-vector-v0"
    },
    "name": {
      "pattern": "^[A-Za-z0-9._:-]{1,128}$",
      "type": "string"
    },
    "policy_profile_id": {
      "pattern": "^policy-[A-Za-z0-9._:-]{1,121}$",
      "type": "string"
    },
    "request": {
      "additionalProperties": false,
      "properties": {
        "account_id": {
          "pattern": "^[A-Za-z0-9._:-]{1,128}$",
          "type": "string"
        },
        "client_pubkey": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "grant_ids": {
          "items": {
            "pattern": "^grant-[A-Za-z0-9._:-]{1,122}$",
            "type": "string"
          },
          "type": "array"
        },
        "grant_usage": {
          "additionalProperties": {
            "additionalProperties": false,
            "properties": {
              "uses": {
                "minimum": 0,
                "type": "integer"
              },
              "window_started_at": {
                "minimum": 1,
                "type": "integer"
              }
            },
            "required": [
              "window_started_at",
              "uses"
            ],
            "type": "object"
          },
          "propertyNames": {
            "pattern": "^grant-[A-Za-z0-9._:-]{1,122}$"
          },
          "type": "object"
        },
        "now": {
          "minimum": 1,
          "type": "integer"
        },
        "permission": {
          "additionalProperties": false,
          "properties": {
            "event_kind": {
              "minimum": 0,
              "type": "integer"
            },
            "method": {
              "minLength": 1,
              "type": "string"
            },
            "parameter": {
              "type": "string"
            }
          },
          "required": [
            "method"
          ],
          "type": "object"
        },
        "revoked_grant_ids": {
          "items": {
            "pattern": "^grant-[A-Za-z0-9._:-]{1,122}$",
            "type": "string"
          },
          "type": "array"
        },
        "route_type": {
          "enum": [
            "esp32_usb_nip46",
            "custom_hardware_wallet",
            "external_nip46"
          ]
        }
      },
      "required": [
        "account_id",
        "route_type",
        "client_pubkey",
        "permission",
        "now",
        "grant_ids",
        "grant_usage",
        "revoked_grant_ids"
      ],
      "type": "object"
    }
  },
  "required": [
    "name",
    "format",
    "policy_profile_id",
    "request",
    "decision"
  ],
  "title": "nSealr Policy Decision Vector v0",
  "type": "object"
}
