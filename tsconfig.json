{
  "compilerOptions": {
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022",
    "types": [
      "node",
      "vitest/globals"
    ]
  },
  "exclude": [
    "apps/bridge/*/dist",
    "packages/*/dist"
  ],
  "include": [
    "apps/**/*.ts",
    "packages/**/*.ts"
  ]
}
