+def validate_provenance(snapshot_root: Path, specs: Path) -> None:
+    """Validate local import metadata; it is not a copied upstream fixture."""
+    metadata = json.loads((snapshot_root / "SOURCE.json").read_text())
+    commit = subprocess.check_output(["git", "rev-parse", "HEAD"], cwd=specs, text=True).strip()
+    if metadata.get("repository") != "https://github.com/nSealr/specs" or metadata.get("commit") != commit:
+        raise FixtureSnapshotError("SOURCE.json upstream repository/commit mismatch")
+    source_paths = {p.relative_to(specs).as_posix() for p in (specs / "vectors").rglob("*") if p.is_file()}
+    snapshot_paths = {p.relative_to(snapshot_root).as_posix() for p in (snapshot_root / "vectors").rglob("*") if p.is_file()}
+    recorded = metadata.get("files")
+    if not isinstance(recorded, dict) or not source_paths or set(recorded) != source_paths or set(recorded) != snapshot_paths:
+        raise FixtureSnapshotError("SOURCE.json vector inventory mismatch")
+    for relative, expected in recorded.items():
+        actual = hashlib.sha256((snapshot_root / relative).read_bytes()).hexdigest()
+        if actual != expected:
+            raise FixtureSnapshotError(f"SOURCE.json hash mismatch: {relative}")
+
