{
  "bugs": {
    "url": "https://github.com/nSealr/nsealr/issues"
  },
  "description": "Secretless host-side companion packages for nSealr signer integrations.",
  "devDependencies": {
    "@nsealr/browser-provider": "workspace:*",
    "@nsealr/client": "workspace:*",
    "@nsealr/core": "workspace:*",
    "@nsealr/fixtures": "workspace:*",
    "@nsealr/framing": "workspace:*",
    "@nsealr/nip46": "workspace:*",
    "@nsealr/policy": "workspace:*",
    "@nsealr/protocol": "workspace:*",
    "@nsealr/qr": "workspace:*",
    "@nsealr/review": "workspace:*",
    "@types/node": "24.10.1",
    "esbuild": "0.27.7",
    "nostr-tools": "^2.23.3",
    "tsx": "4.21.0",
    "typescript": "6.0.3",
    "vitest": "4.1.5"
  },
  "homepage": "https://github.com/nSealr/nsealr#readme",
  "license": "MIT",
  "name": "@nsealr/bridge-workspace",
  "packageManager": "pnpm@10.33.4",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@serialport/bindings-cpp",
      "esbuild"
    ]
  },
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nSealr/nsealr.git"
  },
  "scripts": {
    "api-docs:check": "node tools/bridge/check_api_docs.mjs",
    "api-docs:update": "node tools/bridge/check_api_docs.mjs --write",
    "api-review:check": "node tools/bridge/check_api_review.mjs",
    "browser-extension-security:check": "node tools/bridge/check_browser_extension_security.mjs",
    "browser-runtime-bundle:check": "node tools/bridge/check_browser_runtime_bundle.mjs",
    "browser-runtime-imports:check": "node tools/bridge/check_browser_runtime_imports.mjs",
    "build": "node tools/bridge/build_packages.mjs",
    "ci": "pnpm build && pnpm typecheck && pnpm test && pnpm consumer-smoke && pnpm examples-smoke && pnpm readme-examples:check && pnpm api-docs:check && pnpm api-review:check && pnpm package-registry:check && pnpm browser-runtime-imports:check && pnpm browser-runtime-bundle:check && pnpm browser-extension-security:check && pnpm public-imports:check && pnpm release-plan:check && pnpm release-artifacts:safety && pnpm pack-smoke && pnpm product-boundaries:check && pnpm current-guides:check",
    "consumer-smoke": "pnpm --filter @nsealr/consumer-smoke smoke",
    "current-guides:check": "node --import tsx/esm tools/bridge/check_current_guides.mjs && node --import tsx/esm tools/bridge/test_current_guides.mjs",
    "examples-smoke": "pnpm --filter @nsealr/sdk-examples verify",
    "lint": "tsc --noEmit",
    "nsealr": "pnpm --filter @nsealr/cli nsealr",
    "nsealr-service": "pnpm --filter @nsealr/service service",
    "pack-smoke": "node tools/bridge/pack_smoke.mjs",
    "package-registry:check": "node tools/bridge/check_package_registry.mjs",
    "product-boundaries:check": "node tools/bridge/check_product_boundaries.mjs && node tools/bridge/test_product_boundaries.mjs",
    "public-imports:check": "node tools/bridge/check_public_imports.mjs",
    "readme-examples:check": "node tools/bridge/check_readme_examples.mjs",
    "release-artifacts": "node tools/bridge/prepare_release_artifacts.mjs --out release-artifacts/packages",
    "release-artifacts:safety": "node tools/bridge/check_release_artifacts_safety.mjs",
    "release-plan": "node tools/bridge/release_plan.mjs",
    "release-plan:check": "node tools/bridge/check_release_plan.mjs",
    "test": "vitest run --maxWorkers=4",
    "typecheck": "tsc --noEmit"
  },
  "type": "module",
  "version": "0.1.0"
}
